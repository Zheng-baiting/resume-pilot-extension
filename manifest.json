{
  "manifest_version": 3,
  "name": "简历领航 Resume Pilot",
  "version": "1.0.1",
  "description": "从简历生成岗位方向，在企业官网核验真实岗位、地点和流程后辅助填写并按授权投递。",
  "permissions": ["storage", "tabs", "activeTab", "alarms"],
  "host_permissions": ["https://www.bing.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "简历领航",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["main-click.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["city-preferences.js", "scoring.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
