{
  "manifest_version": 3,
  "name": "简历领航 Resume Pilot",
  "version": "2.0.0",
  "key": "",
  "description": "混合桌面控制中心与浏览器执行器，在企业官网核验真实岗位、地点和流程后按授权辅助投递。",
  "permissions": ["storage", "tabs", "activeTab", "alarms", "nativeMessaging"],
  "host_permissions": ["https://www.bing.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "简历领航",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["main-click.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["city-preferences.js", "scoring.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
